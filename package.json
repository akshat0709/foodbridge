{
  "name": "foodbridge",
  "version": "1.0.0",
  "description": "Food redistribution and waste-prediction platform connecting hostel messes with nearby NGOs",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm --prefix server run build && npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT,ML\" -c \"cyan,green,yellow\" \"npm run server\" \"npm run client\" \"npm run ml\"",
    "dev:app": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "ml": "cd ml && source venv/bin/activate && uvicorn main:app --port 8000",
    "seed": "npx --prefix server tsx scripts/generate_dataset.js --scale 100k",
    "benchmark": "npx --prefix server tsx scripts/run_benchmarks.js",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "big-data",
    "mongodb",
    "food-waste",
    "logistics",
    "machine-learning"
  ],
  "author": "FoodBridge Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "pdfkit": "^0.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
