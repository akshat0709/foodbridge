# FoodBridge Environment Configuration
NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge
# Required in production (min 16 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://127.0.0.1:8000
# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed when the frontend and API share a domain (Vite proxy / Vercel rewrites).
CORS_ORIGIN=http://localhost:5173

# Impact Metric Factors
KG_PER_MEAL=0.4
CO2E_FACTOR_PER_KG=2.5
COST_PER_KG_RS=60.0
